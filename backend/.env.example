PORT=4000
FRONTEND_URL=http://localhost:3000

# Choose the active database provider.
# - supabase: current cloud-backed mode
# - postgres: local PostgreSQL mode
DB_PROVIDER=postgres

# Local PostgreSQL mode
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=eschool
DB_USER=postgres
DB_PASSWORD=change-me

# You can use DATABASE_URL instead of the individual DB_* values.
# DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/eschool

# Local file storage for slips and future uploads
DATA_DIR=./data
PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase mode (keep these for routes that are not migrated yet)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Frontend can still point to the local backend in local-first mode.
ALLOWED_ORIGINS=http://localhost:3000

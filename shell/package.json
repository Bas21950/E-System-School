{
  "name": "e-system-school-shell",
  "version": "1.2.11",
  "description": "E-System School desktop application",
  "author": "Sahawittayanusorn School",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:runtime": "node prepare-runtime-dependencies.js",
